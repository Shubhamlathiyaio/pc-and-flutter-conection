# ---- Server & Auth ----
NODE_ENV=development
API_PORT=3000
JWT_SECRET=devsecretkey123456789

# ---- PostgreSQL Database ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=product_catalog
DB_USER=postgres
DB_PASSWORD=postgres123

# ---- CORS (Allow local Flutter/web apps) ----
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# ---- Redis (Optional, for caching - safe to ignore for now) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Admin for pgAdmin (DB manager web UI) ----
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123
PGADMIN_PORT=8080
